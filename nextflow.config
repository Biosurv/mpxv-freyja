manifest {
    name = 'mpxv-freyja'
    description = 'Reference-based assembly of ONT amplicon data with medaka, coverage statistics and Freyja clade calls'
    mainScript = 'main.nf'
    nextflowVersion = '!>=26.04.0'
    version = '0.1.0'
}

params {
    outdir = 'results'
}

outputDir = params.outdir
workflow.output.mode = 'copy'

process {
    cpus = 1
    memory = 4.GB
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
    maxRetries = 1

    withName: 'PREPARE|MERGE' {
        errorStrategy = 'terminate'
    }
    withLabel: 'medaka' {
        container = 'quay.io/biocontainers/medaka:2.2.2--py312h3050eb1_0'
        conda = "${projectDir}/envs/medaka.yml"
    }
    withLabel: 'seqkit' {
        container = 'quay.io/biocontainers/seqkit:2.14.0--hb192632_0'
        conda = "${projectDir}/envs/seqkit.yml"
    }
    withLabel: 'freyja' {
        container = 'quay.io/biocontainers/freyja:2.0.6--pyhdfd78af_0'
        conda = "${projectDir}/envs/freyja.yml"
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
    conda {
        conda.enabled = true
        conda.createTimeout = '1 h'
    }
    test {
        params.reads = "${projectDir}/tests/data/fastq_pass"
        params.reference = "${projectDir}/tests/data/reference.fasta"
        params.primers = "${projectDir}/tests/data/primers.bed"
        params.freyja_barcodes = "${projectDir}/tests/data/barcodes.csv"
    }
}
